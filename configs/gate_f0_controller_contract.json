    "variants": {
      "HOLD": {
        "fields": [
          "decision_time_s",
          "absolute_time_frame_id"
        ],
        "meaning": "No intentional topology reconfiguration at this decision epoch."
      },
      "REPLACE": {
        "fields": [
          "decision_time_s",
          "absolute_time_frame_id",
          "old_physical_binding.endpoint_a.satellite_id",
          "old_physical_binding.endpoint_a.terminal_id",
          "old_physical_binding.endpoint_b.satellite_id",
          "old_physical_binding.endpoint_b.terminal_id",
          "new_terminal_pair.endpoint_a.satellite_id",
          "new_terminal_pair.endpoint_a.terminal_id",
          "new_terminal_pair.endpoint_b.satellite_id",
          "new_terminal_pair.endpoint_b.terminal_id"
        ],
        "old_binding_must_be_exact_physical_pair": true,
        "new_pair_must_be_exact_dynamic_terminal_pair": true
      }
    },
    "controller_may_declare_transition_mode": false,
