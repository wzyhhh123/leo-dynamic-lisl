  "common_router_rule": {
    "rule": "For every candidate topology G, recompute every required admitted path and node-local admitted next hop with the currently selected frozen common router.",
    "same_router_for_hold_and_all_candidates": true,
    "packet_next_hop_is_not_a_controller_action": true
  },
  "numerical_semantics": {
    "queue_key_scan_tolerance_bits": 1e-12,
    "queue_backlog_tolerance_source": "engine.state_tolerance_bits",
    "gate_d0_state_tolerance_bits": 0.01,
    "input_tolerance_bit_s": 1e-15,
    "allocator_tolerance_source": "existing equal_weight_fair_share default tolerance",
    "new_threshold_introduced": false
  },
  "scheduler_consistent_snapshot": {
    "global_active_commodity_set": false,
    "local_input_symbol": "u_i_f(t)",
    "local_input_construction": [
      "add current external lambda_f(t) at commodity source",
      "add every currently arriving downstream in_flight.arrival_rate at its edge head"
    ],
    "aggregate_I_f_is_service_demand_indicator": false,
    "demand_rules": {
      "destination": "0",
      "positive_required_demand_without_legal_admitted_next_hop": "INVALID_TARGET_VALUE_PLUS_INFINITY",
      "queue_above_engine_state_tolerance": "+infinity",
      "otherwise_positive_current_input": "u_i_f(t)",
      "otherwise": "0"
    },
    "grouping": "collect positive local demands by recomputed directed admitted next hop",
    "allocator": "dynamic_lisl.service_scheduler.equal_weight_fair_share",
    "allocator_reimplementation_forbidden": true,
    "allocation_symbol": "mu_i_f(G,t)"
  },
  "definitions": {
    "unfinished_work": {
      "symbol": "N_f(t)",
      "formula": "A_f(t) - D_f(t) = sum_i Q_i^f(t) + sum_e I_e^f(t)"
    },
    "propagation_cost": {
      "symbol": "C_f_prop(G,t)",
      "formula": "sum_{e in P_f(G,t)} d_e(t)/c"
    },
    "commodity_current_demand_nodes": {
      "symbol": "D_f(G,t)",
      "formula": "{i : demand_i_f(G,t) > 0 and a legal admitted next hop exists}",
      "node_local_not_global_commodity_active_set": true
    },
    "current_service_bottleneck_snapshot": {
      "symbol": "R_f_snap(G,t)",
      "formula": "min_{i in D_f(G,t)} mu_i_f(G,t)",
      "interpretation": "current-service bottleneck snapshot proxy, not exact end-to-end throughput"
    },
    "service_area_term": {
      "symbol": "Psi_f(G,t)",
      "when_current_demand_nonempty": "N_f(t)^2 / (2*R_f_snap(G,t))",
      "when_current_demand_empty": "0"
    },
    "snapshot_value": {
      "symbol": "V_v2(G,t)",
      "formula": "sum_{f:N_f(t)>0} [N_f(t)*C_f_prop(G,t) + Psi_f(G,t)]",
      "optimization_direction": "MINIMIZE"
    }
  },
  "edge_rules": {
    "zero_total_unfinished_work": "HOLD",
    "unrouted_positive_unfinished_commodity_target_value": "+infinity",
    "positive_local_demand_without_legal_admitted_next_hop": "+infinity",
    "nonpositive_mu_for_positive_local_demand": "+infinity",
    "route_exists_but_current_demand_empty": "Psi_f=0 and do not invent R_f_snap",
    "B3_nonpositive_remaining_or_usable_lifetime": "INELIGIBLE",
    "hold_replace_exact_tie": "HOLD",
    "replace_replace_exact_tie": "FROZEN_PROPOSER_CANONICAL_ORDER",
    "trainable_coefficients": false,
    "alpha_beta_gamma_weights": false,
    "realized_future_traffic": false,
    "performance_based_tuning": false
  },
  "evaluation_semantics": {
    "information_class": "CURRENT_STATE_ONLY",
    "analytic_snapshot_only": true,
    "advance_simulation_time": false,
    "multi_step_rollout": false,
    "final_J": false,
    "aggregate_unfinished_work_proxy": true,
    "propagation_term_interpretation": "N_f*C_f_prop is not exact remaining propagation work because N_f includes in-flight bits that may have traversed part of the path.",
    "queue_area_term_interpretation": "N_f^2/(2*R_f_snap) is a constant-current-service queue-area proxy when current demand exists, not exact multi-hop residual-work area or future queue evolution."
  },
  "B1": {
    "hold_value": "V_H = V_v2(G_current,t)",
    "candidate_value": "V_c = V_v2(G_c_ideal,t)",
    "candidate_decision_setup_s": 0.0,
    "zero_setup_scope": "DECISION_EVALUATION_ONLY",
    "selection": "argmin over HOLD and all candidates",
    "real_replace_execution": "REAL_GATE_B_C_SETUP",
    "scalar_score_resolved": true
  },
  "B2": {
    "base_signal_symbol": "DeltaV_c",
    "base_signal_formula": "V_H - V_c",
    "base_signal_resolved": true,
    "minimum_hold_grid_frozen_here": false,
    "hysteresis_grid_frozen_here": false
  },
  "B3": {
    "economic_reject_rule": "DeltaV_c <= 0",
    "lifetime_fraction_symbol": "eta_c",
    "lifetime_fraction_formula": "L_usable,c / L_remaining,c",
    "score_symbol": "S_c",
    "score_formula": "DeltaV_c * eta_c",
    "selection": "candidate with maximum positive S_c; otherwise HOLD",
    "scalar_score_resolved": true
  },
  "compatibility_fixture": {
    "required_state": "Q=0, lambda=0, I>0",
    "pure_propagation_gap": {
      "current_local_demand": "EMPTY",
